# ============================================================================
# LITIBOOK ENVIRONMENT CONFIGURATION (.env.local)
# Nếu để trống Supabase / R2 khi chạy thử trên máy cá nhân, Litibook tự động
# vận hành mượt 100% qua kho dữ liệu tệp cục bộ (data/library_db.json + public/uploads).
# ============================================================================

# 1. Xác thực Chủ thư viện tại /admin/login
ADMIN_PASSWORD=goc-cay-soi-2026
ADMIN_SESSION_SECRET=litibook-family-secret-change-in-production

# 2. Supabase (Tùy chọn — tự động kích hoạt PostgreSQL khi điền đủ 2 biến dưới đây)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Cloudflare R2 cho Audio 48kHz & Tranh 3:4 (Tùy chọn — 10GB miễn phí, 0đ băng thông)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=litibook-media
NEXT_PUBLIC_R2_PUBLIC_URL=
